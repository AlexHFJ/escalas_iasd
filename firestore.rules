rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Config da igreja — leitura pública, escrita só para autenticados
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Config de cada ministério (imagem + observações)
    match /ministryConfig/{ministryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Escalas — leitura pública, escrita só para o diretor do ministério ou admin
    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if request.auth != null && (
        // Admin pode tudo
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        ||
        // Diretor só pode no seu ministério
        scheduleId.matches(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ministry + '_.*'
        )
      );
    }

    // Perfis dos usuários — leitura/escrita só para autenticados
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }
  }
}
